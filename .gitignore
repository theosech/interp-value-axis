# Environment
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.codex_scratch/
.claude/settings.local.json

# Upstream repo, cloned not vendored. See README "Setup" -- pinned to 44ad182.
value-axis/

# Large artifacts. results/MANIFEST.md documents every file and how to
# regenerate it. Small, expensive-to-regenerate outputs are re-included below.
results/*
!results/MANIFEST.md
!results/*.json
!results/*.jsonl
!results/*.csv
!results/value_axis_corrected.npy

# ...except the multi-MB JSON payloads, which are regenerated by their build script.
results/prefill_probes.json
results/prefill_rephrase.json
results/extended_retries.json

# Published write-up page (hosted as an Artifact), and the private email draft
artifact/
EMAIL_DRAFT.md
